#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
CONTAINER_NAME="chatterbox-app-postgres"

set -a
source "$PROJECT_ROOT/.env"
set +a

: "${DB_HOST:=localhost}"
: "${DB_PORT:=5432}"
: "${DB_NAME:=app_db}"
: "${DB_USER:=app_user}"
: "${DB_PASSWORD:=changeme}"

ensure_docker_service() {
  if systemctl is-active --quiet docker 2>/dev/null; then
    return 0
  fi

  echo "==> Docker service is not running. Starting it..."
  if ! systemctl start docker 2>/dev/null && ! sudo systemctl start docker; then
    echo "ERROR: Failed to start the Docker service."
    exit 1
  fi

  for _ in {1..30}; do
    if systemctl is-active --quiet docker 2>/dev/null; then
      return 0
    fi
    sleep 1
  done

  echo "ERROR: Docker service did not become active."
  exit 1
}

wait_for_postgres() {
  echo "==> Waiting for PostgreSQL to accept connections..."
  for _ in {1..60}; do
    if docker exec "$CONTAINER_NAME" pg_isready -U "$DB_USER" -d "$DB_NAME" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done

  echo "ERROR: PostgreSQL did not become ready in time."
  exit 1
}

ensure_docker_service

if ! command -v docker >/dev/null 2>&1; then
  echo "ERROR: docker command not found. Install Docker first."
  exit 1
fi

if docker ps -a --format '{{.Names}}' | grep -qx "$CONTAINER_NAME"; then
  if docker ps --format '{{.Names}}' | grep -qx "$CONTAINER_NAME"; then
    echo "==> PostgreSQL container already running."
  else
    echo "==> Starting existing PostgreSQL container..."
    docker start "$CONTAINER_NAME" >/dev/null
  fi
else
  echo "==> Pulling latest PostgreSQL image..."
  docker pull postgres:latest

  echo "==> Launching PostgreSQL container..."
  docker run -d \
    --name "$CONTAINER_NAME" \
    -e POSTGRES_USER="$DB_USER" \
    -e POSTGRES_PASSWORD="$DB_PASSWORD" \
    -e POSTGRES_DB="$DB_NAME" \
    -p "${DB_PORT}:5432" \
    postgres:latest >/dev/null
fi

wait_for_postgres

echo ""
echo "==> PostgreSQL is ready."
echo "    Host:     ${DB_HOST}"
echo "    Port:     ${DB_PORT}"
echo "    Database: ${DB_NAME}"
echo "    User:     ${DB_USER}"
echo "    Container: ${CONTAINER_NAME}"
